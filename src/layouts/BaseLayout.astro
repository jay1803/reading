---
import { base } from '../lib/base';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/about`}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html {
    color-scheme: light;
  }
  body {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
    background: #fff;
    color: #222;
  }
  h1, h2, h3 {
    color: #111;
  }
  header nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }
  a {
    color: #0645ad;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    margin-bottom: 1.25rem;
  }
  .post-list time {
    color: #666;
    font-size: 0.85rem;
    display: block;
  }
  .category-tag {
    display: inline-block;
    font-size: 0.75rem;
    background: #f0f0f0;
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
    margin-top: 0.25rem;
    color: #444;
    text-decoration: none;
  }
</style>
