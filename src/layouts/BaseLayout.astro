---
import { base } from '../lib/base';
import { panguSpace } from '../lib/rehype-pangu.mjs';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{panguSpace(title)}</title>
    {description && <meta name="description" content={panguSpace(description)} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
            document.documentElement.style.colorScheme = saved;
          }
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress><div class="scroll-progress-bar"></div></div>

    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-title-group">
          <a class="wordmark" href={`${base}/`}>Max Daily Reading</a>
        </div>
        <nav class="masthead-nav">
          <a href={`${base}/`}>Archive</a>
          <a href={`${base}/stats`}>Stats</a>
          <a href={`${base}/about`}>About</a>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch between light and dark theme"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.5v2.6M12 18.9v2.6M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12h2.6M18.9 12h2.6M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" stroke-linecap="round" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" stroke-linejoin="round" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">
      <div class="colophon-inner">
        <span>Max Daily Reading &nbsp;&middot;&nbsp; every entry links back to its source</span>
        <span>
          Designed by Claude + <a href="https://maxoxo.me" target="_blank" rel="noopener noreferrer">Max</a>
        </span>
        <a href={`${base}/`}>Archive</a>
      </div>
    </footer>

    <script>
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress] .scroll-progress-bar');
      if (bar) {
        const onScroll = () => {
          const el = document.documentElement;
          const max = el.scrollHeight - el.clientHeight;
          const pct = max > 0 ? Math.min(100, (el.scrollTop / max) * 100) : 0;
          bar.style.width = pct + '%';
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        root.style.colorScheme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f4ed;
    --paper-raised: #f1ede3;
    --line: #e3ded2;
    --line-soft: #ecE7db;
    --ink: #1e1c19;
    --ink-soft: #5d574d;
    --ink-faint: #6f695d;
    --accent: #2f5d50;
    --accent-soft: #c9d8d0;
    --selection: #d8e2dc;

    --font-display: 'Newsreader', 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', Georgia, serif;
    --font-em: 'Newsreader', 'Kaiti SC', 'STKaiti', 'KaiTi', 'Noto Serif SC', Georgia, serif;
    --font-mono: 'TX-02', 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;

    --measure: 41.25rem;
    --wide: 67.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #17181a;
      --paper-raised: #202124;
      --line: #333429;
      --line-soft: #2a2b27;
      --ink: #e8e4d9;
      --ink-soft: #a9a493;
      --ink-faint: #948c7c;
      --accent: #6fae94;
      --accent-soft: #2c4139;
      --selection: #2c4139;
    }
  }
  :root[data-theme='dark'] {
    --paper: #17181a;
    --paper-raised: #202124;
    --line: #333429;
    --line-soft: #2a2b27;
    --ink: #e8e4d9;
    --ink-soft: #a9a493;
    --ink-faint: #8d8676;
    --accent: #6fae94;
    --accent-soft: #2c4139;
    --selection: #2c4139;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: light dark;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    /* Chinese has no true italic form — without this, browsers fake it by
       slanting CJK glyphs, which just looks broken. Combined with --font-em
       (Kaiti stands in for italic emphasis in CJK), this keeps Latin text
       genuinely italic while CJK renders upright in Kaiti instead.
       ("style none" is invalid — font-synthesis takes either the single
       keyword none, or a list of the features still allowed to synthesize.) */
    font-synthesis: weight small-caps;
  }

  ::selection {
    background: var(--selection);
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a:hover {
    color: var(--ink);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    z-index: 20;
  }
  .scroll-progress-bar {
    height: 100%;
    background: var(--accent);
    width: 0%;
    transition: width 0.12s linear;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0.9rem 2.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .masthead-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .masthead-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .masthead-nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .masthead-nav a:hover {
    color: var(--ink);
  }

  .theme-toggle {
    appearance: none;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-soft);
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  .theme-toggle svg {
    width: 15px;
    height: 15px;
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .masthead-inner {
      padding: 0.85rem 1.25rem;
    }
  }

  main {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  @media (max-width: 640px) {
    main {
      padding: 0 1.25rem;
    }
  }

  .prose {
    color: var(--ink);
  }
  .prose p {
    font-size: 1.15rem;
    line-height: 1.78;
    margin: 0 0 1.7rem;
    text-wrap: pretty;
  }
  .prose h1,
  .prose h2,
  .prose h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    margin: 3em 0 1.2em;
  }
  .prose ul,
  .prose ol {
    margin: 0 0 1.7rem;
    padding-left: 1.3em;
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .prose li {
    margin-bottom: 0.5em;
  }
  .prose blockquote {
    margin: 2.5rem 0;
    padding: 0 0 0 1.75rem;
    border-left: 2px solid var(--accent-soft);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1.45;
    font-style: italic;
    font-family: var(--font-em);
    letter-spacing: -0.01em;
  }
  .prose em,
  .prose i {
    font-style: italic;
    font-family: var(--font-em);
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--paper-raised);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .prose pre {
    background: var(--paper-raised);
    padding: 1em;
    border-radius: 4px;
    overflow-x: auto;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose strong {
    font-weight: 600;
  }
  .prose a {
    color: var(--accent);
  }

  .colophon {
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .colophon-inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .colophon a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .colophon a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .colophon-inner {
      padding: 2.5rem 1.25rem;
    }
  }
</style>
