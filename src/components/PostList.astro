---
interface Props {
  posts: { id: string; data: { title: string; date: Date; category: string } }[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`${import.meta.env.BASE_URL}/${post.id}/`}>
          <strong>{post.data.title}</strong>
        </a>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
        <a class="category-tag" href={`${import.meta.env.BASE_URL}/category/${post.data.category}/`}>
          {post.data.category}
        </a>
      </li>
    ))
  }
</ul>
